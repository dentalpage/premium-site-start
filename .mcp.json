{
  "mcpServers": {
    "weegloo": {
      "type": "http",
      "url": "https://ai.weegloo.com/mcp"
    },
    "weegloo-upload": {
      "command": "npx",
      "args": [
        "-y",
        "weegloo-upload@latest"
      ],
      "env": {
        "UPLOAD_API_URL": "https://upload.weegloo.com/v1",
        "NODE_USE_ENV_PROXY": "1"
      }
    }
  }
}
